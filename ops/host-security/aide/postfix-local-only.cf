# Applied with postconf -e. Postfix is installed only because aide-common
# depends on a local mail transport.
inet_interfaces = loopback-only
inet_protocols = all
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
smtpd_relay_restrictions = permit_mynetworks,reject

# Do not disclose Postfix or Ubuntu versions in the local-only SMTP banner.
smtpd_banner = $myhostname ESMTP
