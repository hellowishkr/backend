{
  "default-address-pools": [
    {
      "base": "172.28.0.0/16",
      "size": 24
    }
  ],
  "icc": false,
  "ip6tables": true,
  "iptables": true,
  "live-restore": true,
  "log-driver": "json-file",
  "log-opts": {
    "compress": "true",
    "max-file": "5",
    "max-size": "10m"
  },
  "no-new-privileges": true,
  "userland-proxy": false
}
