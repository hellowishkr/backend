[Unit]
Description=Export Wishkr origin TLS certificate metrics for Grafana Alloy
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=alloy
ExecStart=/usr/local/sbin/wishkr-export-tls-certificate-metrics
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/wishkr/tls/api.wishkr.com-origin.pem
InaccessiblePaths=/etc/wishkr/tls/api.wishkr.com-origin.key
ReadWritePaths=/var/lib/alloy/textfile
UMask=0027
